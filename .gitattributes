# Auto detect text files and normalize line endings to LF on checkout
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bib text eol=lf
*.cff text eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pptx binary
*.npz binary
